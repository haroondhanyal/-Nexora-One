# Copy to .env in this folder. Shell environment variables take precedence.
# Empty WEB_BASE_URL starts the local Nexora web app in demo mode.
WEB_BASE_URL=

# Optional authenticated API contract/persistence runs.
API_BASE_URL=
E2E_TOKEN=
TENANT_ID=
NEXORA_E2E_ALLOW_WRITES=0

# Optional direct PostgreSQL checks. Use a disposable test database and non-superuser role.
NEXORA_TEST_DATABASE_URL=
NEXORA_TEST_DATABASE_ALLOW_WRITE=0

# Runner and report settings.
PW_WORKERS=34
CI=
REPORT_PORT=4178
K6_VUS=8
K6_MAX_DURATION=2m
# Optional resource IDs for 200-status detail/download cases; leave empty to use safe not-found IDs.
K6_RESOURCE_IDS={}
