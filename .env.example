# Local-only development secrets. Replace every value before starting services.
POSTGRES_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
ODOO_DB_PASSWORD=replace-with-a-different-long-random-password
ODOO_MASTER_PASSWORD=replace-with-another-long-random-password
ODOO_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
ATTENDANCE_DEVICE_MASTER_KEY=replace-with-a-unique-random-key-at-least-32-bytes
ODOO_BASE_URL=http://odoo:8069

# Local mail is captured by Mailpit and never sent externally.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=noreply@nexora.local
PUBLIC_WEB_URL=http://localhost:3000
